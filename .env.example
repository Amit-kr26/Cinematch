# CineMatch configuration — copy to .env and adjust.
# docker compose reads this file automatically for ${VAR} interpolation.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=recsys
POSTGRES_PASSWORD=recsys
POSTGRES_DB=recsys

# ── TMDB (posters/descriptions; free key at themoviedb.org) ──────────────────
TMDB_API_KEY=

# ── Application ───────────────────────────────────────────────────────────────
KAFKA_TOPIC=user-events      # Kafka topic for user events (API, Spark, simulator)
EVENT_RATE=5                 # synthetic events/sec produced by the simulator
API_PORT=8000                # host port for the FastAPI service

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin

# Connection URLs are fixed inside the compose network (service names):
#   redis://redis:6379 · postgresql://$POSTGRES_USER:…@postgres:5432/$POSTGRES_DB
#   kafka://kafka:9092 · http://mlflow:5000
